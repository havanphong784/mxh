  "main": "index.js",
  "scripts": {
    "build": "npm run contract:emit && tsc --noEmit",
    "lint": "eslint",
    "dev": "node --watch --import @swc-node/register/esm-register src/index.ts",
    "test": "npm run test:posts && npm run test:auth && npm run test:notifications && npm run test:media && npm run test:mail && npm run test:users && npm run test:gateway && npm run test:search && npm run test:retention && npm run test:idempotency",
    "test:search": "node --import @swc-node/register/esm-register src/common/search.test.ts",
    "test:idempotency": "node --import @swc-node/register/esm-register --test src/common/idempotency/*.test.ts src/common/guards/*.test.ts src/common/filters/*.test.ts",
    "test:auth": "node --import @swc-node/register/esm-register --test src/auth/*.test.ts",
    "test:gateway": "node --import @swc-node/register/esm-register src/gateway/events.gateway.test.ts",
    "test:mail": "node --import @swc-node/register/esm-register src/mail/mail.service.test.ts",
    "test:media": "node --import @swc-node/register/esm-register src/media/media.service.test.ts",
    "test:notifications": "node --import @swc-node/register/esm-register --test src/notifications/*.test.ts",
    "test:posts": "node --import @swc-node/register/esm-register src/posts/posts.service.test.ts",
    "test:users": "node --import @swc-node/register/esm-register src/users/users.service.test.ts",
    "test:retention": "node --import @swc-node/register/esm-register src/scripts/purge-retention.test.ts",
    "contract:emit": "prisma contract emit",
    "purge:retention": "node --import @swc-node/register/esm-register src/scripts/purge-retention.ts",
    "reconcile:counters": "node --import @swc-node/register/esm-register src/scripts/reconcile-counters.ts",
    "seed": "node --import @swc-node/register/esm-register src/scripts/seed.ts",
    "seed:check": "node --import @swc-node/register/esm-register src/scripts/seed-data.test.ts"
  },
