# Database (giữ nguyên config của bạn nếu đã có)
DATABASE_URL="postgresql://user:password@localhost:5432/mxh_db?schema=public"

PORT=3001

# JWT Configuration
JWT_ACCESS_SECRET="your-super-secret-access-key-change-this-in-production-123456"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production-654321"
JWT_REFRESH_EXPIRES_IN="7d"

# Cookie Signing Secret
COOKIE_SECRET="cookie-secret-key-very-secure-random-string"
CORS_ORIGIN="http://localhost:3000"

# Cloudinary direct upload
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Mail SMTP Configuration (Ví dụ dùng Gmail App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password" # Mật khẩu ứng dụng 16 ký tự của Google
EMAIL_FROM="\"Mạng Xã Hội\" <your-email@gmail.com>"
