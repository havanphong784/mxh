// use prisma-8

model User {
  id              String   @id @default(cuid(2))
  email           String   @unique
  username        String   @unique
  displayName     String
  passwordHash    String

  bio             String?
  avatarUrl       String?
  avatarPublicId  String?
  bannerUrl       String?
  bannerPublicId  String?

  isActive        Boolean  @default(true)
  isEmailVerified Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       temporal.updatedAt()

  following       Follow[]          @relation("UserFollowing")
  followers       Follow[]          @relation("UserFollowers")

  // Quan hệ
  sessions        Session[]
  otpCodes        OtpVerification[]

  posts           Post[]            @relation("UserPosts")
  postLikes       PostLike[]        @relation("UserPostLikes")
  postBookmarks   PostBookmark[]    @relation("UserPostBookmarks")

  notifications       Notification[]    @relation("UserNotifications")
  notificationActions Notification[]    @relation("UserNotificationActions")
}

model Session {
  id           String    @id @default(cuid(2))
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash    String    // Lưu mã băm SHA-256 của Refresh Token
  userAgent    String?   // Thông tin thiết bị/trình duyệt
  ipAddress    String?   // IP đăng nhập
  isRevoked    Boolean   @default(false)
  expiresAt    DateTime  // Thời điểm token hết hạn

  createdAt    DateTime  @default(now())
  updatedAt    temporal.updatedAt()

  @@index([userId])
  @@index([tokenHash])
}

model OtpVerification {
  id        String   @id @default(cuid(2))
  email     String
  codeHash  String   // Lưu mã băm SHA-256 của OTP 6 số
  type      String   // 'REGISTER_VERIFY' | 'FORGOT_PASSWORD'
  attempts  Int      @default(0) // Số lần nhập sai (max 5)
  expiresAt DateTime // Thời hạn OTP (5 phút)

  createdAt DateTime @default(now())

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, type])
}

model Follow {
  followerId   String
  follower     User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)

  followingId  String
  following    User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

model Post {
  id              String         @id @default(cuid(2))
  authorId        String
  author          User           @relation("UserPosts", fields: [authorId], references: [id], onDelete: Cascade)

  content         String?        // Tối đa 2000 ký tự (rỗng nếu là repost thuần hoặc tombstone)
  visibility      PostVisibility @default(PUBLIC)

  // Cấu trúc phân cấp Thread (Threads model)
  parentId        String?        // Bài cha trực tiếp (nếu là reply)
  parent          Post?          @relation("PostReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies         Post[]         @relation("PostReplies")

  rootId          String?        // Gốc của toàn bộ thread thảo luận
  root            Post?          @relation("ThreadRoot", fields: [rootId], references: [id], onDelete: SetNull)
  rootReplies     Post[]         @relation("ThreadRoot")

  // Repost & Quote
  repostOfId      String?        // Nếu là bài Repost thuần
  repostOf        Post?          @relation("PostReposts", fields: [repostOfId], references: [id], onDelete: Cascade)
  reposts         Post[]         @relation("PostReposts")

  quotedPostId    String?        // Nếu là bài Quote có nội dung riêng
  quotedPost      Post?          @relation("PostQuotes", fields: [quotedPostId], references: [id], onDelete: SetNull)
  quotes          Post[]         @relation("PostQuotes")

  // Trạng thái vòng đời
  isDeleted       Boolean        @default(false) // Đánh dấu Tombstone
  editedAt        DateTime?

  // Bộ đếm phi chuẩn hoá (Atomic counters)
  likeCount       Int            @default(0)
  replyCount      Int            @default(0)
  repostCount     Int            @default(0)
  quoteCount      Int            @default(0)
  bookmarkCount   Int            @default(0)

  createdAt       DateTime       @default(now())
  updatedAt       temporal.updatedAt()

  // Quan hệ tương tác & media
  media           PostMedia[]
  likes           PostLike[]
  bookmarks       PostBookmark[]
  notifications   Notification[]

  // Indexes tối ưu hiệu năng truy vấn
  @@index([authorId, createdAt])
  @@index([createdAt])
  @@index([parentId, createdAt])
  @@index([rootId, createdAt])
  @@index([repostOfId])
  @@index([quotedPostId])
  @@unique([authorId, repostOfId]) // 1 user chỉ repost thuần 1 bài gốc đúng 1 lần
}

model PostMedia {
  id          String    @id @default(cuid(2))
  postId      String
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  publicId    String    // Cloudinary Public ID (phải có prefix mxh/{userId}/posts/)
  url         String    // Cloudinary Secure URL
  type        MediaType
  width       Int?
  height      Int?
  duration    Float?    // Thời lượng giây đối với VIDEO / AUDIO
  order       Int       @default(0) // Thứ tự hiển thị (0 -> 9)

  createdAt   DateTime  @default(now())

  @@index([postId, order])
}

model PostLike {
  userId      String
  user        User      @relation("UserPostLikes", fields: [userId], references: [id], onDelete: Cascade)
  postId      String
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())

  @@id([userId, postId])
  @@index([postId, createdAt])
  @@index([userId, createdAt])
}

model PostBookmark {
  userId      String
  user        User      @relation("UserPostBookmarks", fields: [userId], references: [id], onDelete: Cascade)
  postId      String
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())

  @@id([userId, postId])
  @@index([userId, createdAt])
}

enum NotificationType {
  LIKE
  REPLY
  REPOST
  QUOTE
  FOLLOW
}

model Notification {
  id          String           @id @default(cuid(2))

  recipientId String
  recipient   User             @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)

  actorId     String
  actor       User             @relation("UserNotificationActions", fields: [actorId], references: [id], onDelete: Cascade)

  type        NotificationType
  postId      String?
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)

  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([recipientId, isRead, createdAt])
  @@index([recipientId, createdAt])
}